# Logs and temp files
*.log
*.tmp
tmp_*
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# Large binaries in project_archive
*.pdf

# maintenance/: run outputs (regeneratable from archive_inactive.sh inventory/audit)
maintenance/inventory.tsv
maintenance/audit.tsv

# VS Code Local History — edit snapshots must never reach this PUBLIC repo
.history/

# maintenance/dedup: site-specific roots + scan outputs (contain lab paths)
maintenance/dedup/roots.tsv
maintenance/dedup/roots.tsv.local
maintenance/dedup/pilot_roots.tsv
maintenance/dedup/out/
maintenance/dedup/out_pilot/
maintenance/dedup/.current_index_log
maintenance/dedup/.current_verify_log

# maintenance/projects.tsv: the live project registry names lab project dirs (owner names in the
# dir names) — keep it local; commit only projects.tsv.example
maintenance/projects.tsv

# Globus Connect Personal / globus-cli state and key files — defensive: they live under $HOME and must never
# reach this PUBLIC repo even if a dot-dir is ever copied in
.globusonline/
.globus/
*.pem
*.key
